{
  "version": 2,
  "builds": [
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "**/*.css", "use": "@vercel/static" },
    { "src": "**/*.js", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/cards/best-travel-credit-cards-2024-detailed-comparison", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-2024-for-mile-collectors", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-2024-for-mileage-rewards", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-2024-miles-points", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-frequent-flyer-miles-2024", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-mile-collectors-2024", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-mileage-2024", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-mileage-enthusiasts-2024", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-miles-2024", "destination": "/cards/best-travel-credit-cards/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-europe-2024", "destination": "/cards/best-travel-credit-cards-for-europe/", "permanent": true },
    { "source": "/cards/best-travel-credit-cards-for-flights-2025", "destination": "/cards/best-travel-credit-cards-for-flights/", "permanent": true },
    { "source": "/guides/budapest-budget-travel-guide-2024", "destination": "/guides/budapest-budget-travel-guide/", "permanent": true },
    { "source": "/guides/budapest-on-a-budget-2025-tips-for-thrifty-travelers", "destination": "/guides/budapest-budget-travel-guide/", "permanent": true },
    { "source": "/guides/budapest-on-a-budget-how-to-experience-the-city-for-under-60-a-day", "destination": "/guides/budapest-budget-travel-guide/", "permanent": true },
    { "source": "/guides/budget-friendly-tokyo-guide-2025", "destination": "/guides/budget-friendly-tokyo-guide/", "permanent": true },
    { "source": "/guides/phuket-thailand-budget-travel-guide-2025", "destination": "/guides/phuket-thailand-budget-travel-guide/", "permanent": true },
    { "source": "/guides/tulum-on-a-budget-2025-guide", "destination": "/guides/tulum-on-a-budget-guide/", "permanent": true },
    { "source": "/destinations/bangkok-street-food-guide-best-stalls-2024", "destination": "/destinations/bangkok-street-food-guide/", "permanent": true },
    { "source": "/destinations/best-hostels-in-lisbon-portugal-2025", "destination": "/destinations/best-hostels-in-lisbon/", "permanent": true },
    { "source": "/destinations/lisbon-portugal-three-day-itinerary-on-a-budget", "destination": "/destinations/lisbon-budget-travel-guide/", "permanent": true },
    { "source": "/destinations/lisbon-portugal-weekend-guide-budget-tips", "destination": "/destinations/lisbon-budget-travel-guide/", "permanent": true },
    { "source": "/destinations/lisbon-portugal-weekend-travel-guide-2024", "destination": "/destinations/lisbon-budget-travel-guide/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
